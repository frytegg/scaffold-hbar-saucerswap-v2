# Every variable is optional: each one has a default in the code.

# Leave empty to run without WalletConnect: only browser-injected wallets and the burner wallet are offered.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# JSON-RPC URLs used by the frontend (defaults: https://testnet.hashio.io/api and https://mainnet.hashio.io/api)
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=

# Mirror Node base URLs behind the /api/hedera/account route (defaults: the public Hedera mirror nodes)
HEDERA_MIRROR_TESTNET_URL=
HEDERA_MIRROR_MAINNET_URL=
