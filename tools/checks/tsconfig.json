{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types", "../../packages/hardhat/node_modules/@types"],
    "paths": {
      "typescript": [
        "../../node_modules/typescript/lib/typescript.d.ts",
        "../../packages/nextjs/node_modules/typescript/lib/typescript.d.ts"
      ]
    }
  },
  "include": ["*.mjs", "lib/*.mjs", "test/*.mjs"]
}
